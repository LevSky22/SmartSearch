name = "smartsearch"
main = "src/worker.js"
compatibility_date = "2025-04-20"

# KV Namespace configuration
# Create a new namespace with: wrangler kv namespace create "RATE_LIMIT_STORE"
# Then replace the ID below with your namespace ID
[[kv_namespaces]]
binding = "RATE_LIMIT_STORE"
id = "YOUR_KV_NAMESPACE_ID_HERE"

# Disable logging by not defining any log settings
# Disable analytics by not defining any datasets

[site]
bucket = "./assets"

# Static asset handling with strict rules
[[rules]]
type = "Text"
globs = ["*.css", "*.html", "opensearch.xml"]
fallthrough = false

[[rules]]
type = "Data"
globs = ["icons/*.{png,ico}", "*.{png,ico,jpg,jpeg}"]
fallthrough = false

[env.production]
# Replace with your custom domain
route = "your-domain.com/*"